#Requires -Version 7.0
# Matugen.psm1
# Builds matugen's config.toml for this machine and runs matugen.
#
# The config is regenerated on every run with absolute Windows paths (no `~`
# expansion needed), and only contains templates for apps that are actually
# installed, so a refresh never creates stray folders for apps you don't have.
# The template files themselves are the same platform-independent ones the
# Linux setup uses (matugen/templates).

Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'WallpaperChanger.Common.psm1') -DisableNameChecking

function ConvertTo-TomlString {
    # TOML basic string with forward slashes (matugen accepts them on Windows).
    param([Parameter(Mandatory)][string]$Value)
    '"' + (($Value -replace '\\', '/') -replace '"', '\"') + '"'
}

function Get-MatugenTemplateSet {
    # Each entry: Name, Input (file name in matugen\templates), Output (absolute path).
    $paths = Get-WcPaths
    $mc = $paths.MatugenCache
    $set = [System.Collections.Generic.List[hashtable]]::new()

    # Always rendered: the seed color and the VS Code palette the VscodePatcher reads.
    $set.Add(@{ Name = 'source_color'; Input = 'source-color.txt'; Output = Join-Path $mc 'source-color' })
    $set.Add(@{ Name = 'vscode-raw'; Input = 'vscode-colors-template'; Output = Join-Path $mc 'vscode-colors' })
    $set.Add(@{ Name = 'vscode-json'; Input = 'vscode-colors-template.json'; Output = Join-Path $mc 'vscode-colors.json' })

    if ($env:APPDATA) {
        $vesktop = Join-Path $env:APPDATA 'vesktop'
        if (Test-Path -LiteralPath $vesktop) {
            $set.Add(@{ Name = 'vesktop'; Input = 'midnight-discord-template.css'; Output = Join-Path $vesktop 'themes\midnight-discord.css' })
        }
        if (Test-Path -LiteralPath (Join-Path $env:APPDATA 'spicetify')) {
            $set.Add(@{ Name = 'spotify'; Input = 'spicetify-color-template.ini'; Output = Join-Path $env:APPDATA 'spicetify\Themes\Sleek\color.ini' })
        }
    }
    # SourceGit keeps its data in %APPDATA%\SourceGit on Windows; ~\.sourcegit is the Linux-style fallback.
    $sgDir = @((Join-Path $env:APPDATA 'SourceGit'), (Join-Path $env:USERPROFILE '.sourcegit')) |
        Where-Object { $_ -and (Test-Path -LiteralPath $_) } | Select-Object -First 1
    if ($sgDir) { $set.Add(@{ Name = 'sourcegit'; Input = 'sourceGit-theme.json'; Output = Join-Path $sgDir 'matugen-theme.json' }) }
    $set
}

function Get-SourceGitDir {
    @((Join-Path $env:APPDATA 'SourceGit'), (Join-Path $env:USERPROFILE '.sourcegit')) |
        Where-Object { $_ -and (Test-Path -LiteralPath $_) } | Select-Object -First 1
}

function New-MatugenConfig {
    # Writes matugen\config.toml and returns its path.
    $paths = Get-WcPaths
    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add('# Generated by Matugen.psm1 on every refresh - edit the template list there, not here.')
    $lines.Add('[config]')
    $lines.Add('source_color_index = 0')
    $lines.Add('')
    foreach ($t in (Get-MatugenTemplateSet)) {
        $in = Join-Path $paths.Templates $t.Input
        if (-not (Test-Path -LiteralPath $in)) { Write-Warning "Matugen template missing: $in"; continue }
        $lines.Add("[templates.$($t.Name)]")
        $lines.Add("input_path = $(ConvertTo-TomlString $in)")
        $lines.Add("output_path = $(ConvertTo-TomlString $t.Output)")
        $lines.Add('')
    }
    # Custom colors the SourceGit / diff templates rely on (same as the Linux config).
    $lines.Add('[config.custom_colors]')
    $lines.Add('diff_added_bg = { color = "#143620", blend = false }')
    $lines.Add('diff_added_fg = { color = "#4CAF50", blend = false }')
    $lines.Add('diff_added    = { color = "#4caf50", blend = true }')
    $lines.Add('diff_removed  = { color = "#f44336", blend = true }')
    $lines.Add('diff_modified = { color = "#2196f3", blend = true }')
    Write-WcFile -Path $paths.MatugenConfig -Content (($lines -join "`n") + "`n")
    $paths.MatugenConfig
}

function Invoke-Matugen {
    # Renders every template for the given seed color. Throws if matugen is
    # missing or fails.
    param([Parameter(Mandatory)][string]$Color)
    $Color = ConvertTo-HexColor $Color
    $exe = Find-Matugen
    if (-not $exe) { throw 'matugen not found. Re-run install-Windows.ps1 (it can build it for you) or run: cargo install matugen --locked' }
    $config = New-MatugenConfig
    New-Item -ItemType Directory -Path (Get-WcPaths).MatugenCache -Force | Out-Null
    $out = & $exe --config $config --quiet color hex "#$Color" 2>&1
    if ($LASTEXITCODE -ne 0) { throw "matugen failed (exit $LASTEXITCODE): $($out -join ' ')" }
    $out | Where-Object { $_ } | ForEach-Object { Write-Output "$_" }
}

function Get-MatugenSourceColor {
    # Seed color matugen itself extracts from an image (candidate $Index of its
    # ranked list). Renders only a one-template config, so no app files are
    # touched. Returns a 6-digit hex string or $null.
    param([Parameter(Mandatory)][string]$ImagePath, [int]$Index = 0)
    $exe = Find-Matugen
    if (-not $exe) { return $null }
    $paths = Get-WcPaths
    $outFile = Join-Path $paths.MatugenCache 'chooser-source-color'
    $cfgFile = Join-Path $paths.MatugenCache 'chooser.toml'
    $tpl = Join-Path $paths.Templates 'source-color.txt'
    Write-WcFile -Path $cfgFile -Content ("[config]`n[templates.seed]`ninput_path = $(ConvertTo-TomlString $tpl)`noutput_path = $(ConvertTo-TomlString $outFile)`n")
    Remove-Item -LiteralPath $outFile -ErrorAction SilentlyContinue
    & $exe --config $cfgFile --quiet image $ImagePath --source-color-index $Index 2>&1 | Out-Null
    if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $outFile)) { return $null }
    $c = (Get-Content -LiteralPath $outFile -Raw).Trim()
    if (Test-HexColor $c) { ConvertTo-HexColor $c } else { $null }
}

Export-ModuleMember -Function *-*
